generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum StorySubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PublicationSettings {
  id              String   @id @default("default")
  publicationName String   @default("Beyond the Statute")
  tagline         String   @default("Understanding the law. Centering lived realities. Advancing justice.")
  description     String   @default("Beyond the Statute is an independent legal research, education, and advocacy platform advancing understanding and meaningful conversations around sexual and gender-based violence.")
  logoUrl         String?  @db.Text
  instagramUrl    String?
  metaTitle       String?
  metaDescription String?
  updatedAt       DateTime @updatedAt
}

model StorySubmission {
  id              String                @id @default(cuid())
  name            String?
  email           String?
  anonymous       Boolean               @default(false)
  title           String
  story           String                @db.Text
  consentToReview Boolean
  status          StorySubmissionStatus @default(PENDING)
  createdAt       DateTime              @default(now())
  reviewedAt      DateTime?

  @@index([status, createdAt])
}

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String?
  contentWarning  String?
  content         String
  featuredImage   String?
  status          ArticleStatus @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  categories ArticleCategory[]
  tags       ArticleTag[]
  comments   Comment[]
  reactions  Reaction[]
  views      ArticleView[]
  reports    ContentReport[]

  @@index([status, publishedAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles ArticleCategory[]
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  articles ArticleTag[]
}

model ArticleCategory {
  articleId  String
  categoryId String

  article  Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model ContentReport {
  id            String              @id @default(cuid())
  articleId     String?
  commentId     String?
  reason        String
  details       String?             @db.Text
  reporterEmail String?
  status        ContentReportStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  reviewedAt    DateTime?

  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([articleId])
  @@index([commentId])
}

model Comment {
  id          String   @id @default(cuid())
  articleId   String
  displayName String?
  username    String?
  email       String?
  content     String
  submissionKey String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reports ContentReport[]

  @@index([articleId, createdAt])
  @@index([submissionKey, createdAt])
}

model Reaction {
  id         String   @id @default(cuid())
  articleId  String
  identifier String
  createdAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, identifier])
  @@index([articleId])
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  status         SubscriberStatus @default(ACTIVE)
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?

  @@index([status])
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  viewedAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, viewedAt])
}
